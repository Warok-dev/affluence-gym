# Base URL of the backend API. Defaults to "/api" (proxied by Vite to the backend in dev/preview).
# Set it to call the backend directly, e.g. http://localhost:8000 (the backend must then allow
# this frontend origin through its ALLOWED_ORIGINS variable).
# VITE_API_URL=http://localhost:8000

# Where the Vite proxy forwards "/api" (dev/preview only).
# API_PROXY_TARGET=http://127.0.0.1:8000
