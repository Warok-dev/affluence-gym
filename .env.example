# Environment variables of Affluence Gym. Copy what you need; never commit real values.
# Production values are set in the Render dashboard (see README, "Déploiement").

# --- backend ---
# PostgreSQL connection string (Neon in production). If empty, SQLite at DB_PATH is used.
DATABASE_URL=
# SQLite file used when DATABASE_URL is empty (local dev).
DB_PATH=affluence.db
# Frontend origins allowed by CORS, comma-separated.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Time zone of the gyms (weekdays, hours, opening hours).
TIMEZONE=America/Toronto
# Quarter-hour snapshot task inside the API process (false if an external cron runs `python -m app.snapshot`).
SNAPSHOT_ENABLED=true
# true only with the synthetic demo database (scripts/seed_demo.py): the app then labels figures as demo data.
DEMO_DATA=false
# Shared secret the university's system sends (X-Api-Key) with turnstile counts. Empty: ingestion disabled.
OFFICIAL_API_KEY=
# A counter silent for longer than this falls back to crowd reports (seconds).
OFFICIAL_STALE_SECONDS=600
# Without an exit counter, presence = entries of the last N minutes (average visit length).
AVERAGE_STAY_MINUTES=75
# Web Push keys for quiet-gym alerts (python scripts/generate_vapid_keys.py). Empty: notifications disabled.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact required by the Web Push protocol, e.g. mailto:you@example.com
VAPID_SUBJECT=
# Port to listen on (set by the host in production; Render uses 10000).
PORT=8000

# --- frontend (build time) ---
# Public URL of the API. Empty -> same-origin "/api" (Vite proxy in dev, nginx in Docker).
VITE_API_URL=
